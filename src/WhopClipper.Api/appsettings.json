{
  "WhopClipper": {
    "AllowedOrigins": [ "http://localhost:5173" ],
    "WorkspaceRoot": "./workspace",
    "YtDlpPath": "yt-dlp",
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "ClaudePath": "claude",
    "CodexPath": "codex",
    "AutoMigrate": true,
    "ProcessTimeoutMinutes": 30,
    "MaxCapturedLogCharacters": 200000,
    "DefaultAiMode": "Compare",
    "MaxConcurrentMediaJobs": 1,
    "RequireEditApproval": true,
    "PreferredVideoQuality": "Best",
    "OverlayFontPath": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
