ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5080
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=whop_clipper;Username=whop_clipper;Password=CHANGE_ME
WhopClipper__WorkspaceRoot=./workspace
WhopClipper__YtDlpPath=yt-dlp
WhopClipper__FfmpegPath=ffmpeg
WhopClipper__FfprobePath=ffprobe
WhopClipper__ClaudePath=claude
WhopClipper__CodexPath=codex
# Optional explicit .ttf/.otf path; Windows automatically falls back to Arial or Segoe UI.
WhopClipper__OverlayFontPath=
WhopClipper__AutoMigrate=true
WhopClipper__ProcessTimeoutMinutes=30
WhopClipper__MaxCapturedLogCharacters=200000
WhopClipper__DefaultAiMode=Compare
WhopClipper__MaxConcurrentMediaJobs=1
WhopClipper__RequireEditApproval=true
WhopClipper__PreferredVideoQuality=Best
WhopClipper__AllowedOrigins__0=http://localhost:5173
